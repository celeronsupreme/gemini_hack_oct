# Copy to .env (never commit .env). The app runs fully in mock mode without a key.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_EXTRACT_MODEL=gemini-3.8-flash
GEMINI_ANALYSIS_MODEL=gemini-4-argon
GEMINI_ANALYSIS_FALLBACK_MODEL=gemini-3.8-flash
APP_TIMEZONE=Europe/London
# DB_PATH=apps/api/data/app.db
# FORCE_MOCK=1   # keep Gemini off even with a key (demo safety)
